# Form talepleri panelde saklanır; Resend e-posta bildirimi isteğe bağlıdır.
# Bu dosyayı .env.local adıyla kopyala ve değerleri doldur.
RESEND_API_KEY=
# Resend'de doğrulanmış bir alan adından gönderici adresi
CONTACT_FROM="Kıvanç Group Web <noreply@kivancgroup.com>"
# Mesajların ulaşacağı adres
CONTACT_TO=info@kivancgroup.com

# Admin: varsayılan parola yok; npm run admin:setup ile hesabınızı oluşturun.
# Kalıcı, yazılabilir veri dizini (belirtilmezse proje içindeki .cms/):
# CMS_DATA_DIR=/kalici/disk/kivanc-cms
# Ters proxy arkasında panelin açıldığı tam adres:
# SITE_ORIGIN=https://kivancgroup.com
# Ücretsiz deneme için Netlify'ın verdiği adresi kullanın:
# SITE_ORIGIN=https://site-adi.netlify.app

# Netlify/Vercel üzerinde kalıcı içerik, hesap, talepler ve medya için Supabase:
# supabase/setup.sql dosyasını önce projenizin SQL editöründe çalıştırın.
SUPABASE_URL=
# Yalnızca sunucu değişkeni; NEXT_PUBLIC_ öneki kullanmayın.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=site-media

# Vercel'de ilk hesabı oluşturmak için isteğe bağlı, özel sunucu değişkenleri.
# Veritabanında hesap yoksa oluşturulur; ilk girişte parola değiştirilir.
# Mevcut bulut hesabı bu değişkenlerle değiştirilmez.
CMS_BOOTSTRAP_USERNAME=
CMS_BOOTSTRAP_PASSWORD=

# Canlı deneme adresinin arama motorlarında listelenmesini engellemek için:
# SITE_NOINDEX=true
