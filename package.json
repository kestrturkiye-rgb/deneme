{
  "name": "kivancgroup-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/index-documents.mjs && next build",
    "start": "next start",
    "assets": "node --use-env-proxy scripts/fetch-assets.mjs",
    "admin:setup": "node scripts/admin-user.mjs",
    "typecheck": "tsc --noEmit",
    "test:cms": "node scripts/test-cms.mjs",
    "cms:import": "node scripts/import-cloud.mjs",
    "test:cloud": "node scripts/test-cloud.mjs",
    "assets:inventory": "node scripts/fetch-assets.mjs --documents --inventory",
    "test:assets": "node scripts/test-assets.mjs",
    "test:site": "node scripts/test-site.mjs",
    "test:video": "node scripts/test-video.mjs",
    "test:product-images": "node --use-env-proxy scripts/test-product-images.mjs",
    "test:languages": "node scripts/test-languages.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@netlify/plugin-nextjs": "5.16.4",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "sharp": "0.35.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
